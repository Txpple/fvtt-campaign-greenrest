      "custom": "",
      "rules": "2024",
      "revision": 1
    },
    "identified": false,
    "unidentified": {
      "description": "<p><em>A plain-seeming longsword, oddly warm to the grip — its fuller inlaid with rose-gold that seems to hold a little daylight even in the dark.</em></p><p>The blade keeps its own history close. Only one who attunes to it will learn what it truly is, and all that it has witnessed.</p>",
      "name": "Rose-Gold Longsword"
    },
